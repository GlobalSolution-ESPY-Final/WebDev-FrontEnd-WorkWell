{
  "framework": null,
  "buildCommand": "npm ci && npm run build",
  "installCommand": "npm ci",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/favicon.ico", "destination": "/favicon.svg", "permanent": true }
  ]
}
